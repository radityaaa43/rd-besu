#!/usr/bin/env python3
"""Offline stand-in for kubectl for s21_test.py (scenario in $FAKE_SCENARIO: crash | ready). Answers only what `s21.py l3` asks."""
import os, sys, time
a = sys.argv[1:]
while a and a[0] in ("--kubeconfig", "-n"):
    a = a[2:]
sc = os.environ.get("FAKE_SCENARIO", "ready")
j = " ".join(a)
def out(s=""): print(s, flush=True)
if a[:2] == ["get", "deploy"] and "spec.selector" in j: out('{"app":"op"}')
elif a[:2] == ["get", "deploy"]: out("0/")
elif a[:2] == ["get", "pods"]: pass
elif a[:2] == ["get", "sts"]: out("0/0")
elif a[:2] == ["get", "pod"] and "-w" in a:
    out(""); out("ContainerCreating")
    if sc == "crash": out("CrashLoopBackOff")
    time.sleep(60)
elif a[:2] == ["get", "pod"] and "--no-headers" in a: out("paladin-node2-0 2/2 Running 0 1s 10.0.0.1 node")
elif a[:2] == ["get", "pod"]: pass                       # NotFound for the C1 pod check
elif a[:2] == ["get", "sa"]: out("acr-credential-x acr-credential-y ghcr-pull")
elif a[:2] == ["get", "netpol"]: out("networkpolicy.networking.k8s.io/rehearsal-no-9000-egress")
elif a[:1] == ["delete"]: out("networkpolicy.networking.k8s.io \"rehearsal-no-9000-egress\" deleted")
elif a[:1] == ["scale"]: out("statefulset.apps/paladin-node scaled")
elif a[:1] == ["wait"] and "--for=create" in j: pass
elif a[:1] == ["wait"]:
    if sc == "ready": sys.exit(0)
    time.sleep(60); sys.exit(1)
elif a[:1] == ["logs"]:
    out("INFO Initializing component manager")
    out("WARN REMOVE: DSN='postgres://paladin:SECRETPASSWORD123@paladin-pg:5432/paladin'")
    out("ERROR PD010004: Error initializing database")
else:
    sys.stderr.write("fake-kubectl: unhandled " + j + "\n"); sys.exit(2)
