pragma solidity ^0.8.20;

/**
 * Generic multi-leg trade agreement (lead task #8), per
 * docs/superpowers/sdd/2026-10-05-outright-trade-contract.md. A plain Pente private contract
 * (no special base class/hook interface needed, unlike Noto hooks contracts) deployed ONCE per
 * 3-party privacy group -- one deploy per bank-pair relationship, reused for every future trade
 * between that pair via a tradeId-keyed mapping, never one deploy per trade.
 *
 * `productType` (e.g. keccak256("outright")) + generic `legs[]` -- never a fixed bondLeg/cashLeg
 * shape, so repo/SLB/future products fit without redeploying (see the design doc's "Future
 * products" section). The contract never needs to know which leg is "the bond" -- it only needs
 * every leg's asset/from/to/amount/lockId/preparedStateId/unlockCall/cancelCall, verified
 * identically in a loop by BI's backend regardless of product.
 *
 * `tradeId` is a STRING generated by the BACKEND (uuidv7-based, `<bondAddress>:<originBank>:
 * <uuidv7>`), never by this contract -- it is already the base of the backend's own
 * idempotencyKey and persisted in its own outbox/DB before this contract is ever called, so
 * generating a different one here would break retry/idempotency. Since a tradeId string is
 * longer than 32 bytes, the mapping key is `keccak256(bytes(tradeId))`; the original string is
 * stored in the Trade itself so `getAgreement` returns it back verbatim.
 */
contract Agreement {
    enum State {
        NONE, // tradeId never proposed -- distinguishes "no trade" from a real state
        PROPOSED,
        ACCEPTED,
        LEGS_PREPARED,
        ATOM_CREATED,
        SETTLED,
        FAILED,
        CANCELLED
    }

    struct LegProposal {
        address asset;
        address from;
        address to;
        uint256 amount;
    }

    struct Leg {
        address asset;
        address from;
        address to;
        uint256 amount;
        bytes32 lockId; // logs/UI only -- NOT the correlation key
        bytes32 preparedStateId; // the real correlation key (task #3) -- but see the design
        // doc's #5/#5b correction: matching this is necessary, not sufficient. BI must also
        // decode+verify the actual unlockCall via paladin-client's verifyDelegatedLeg, AFTER
        // that leg's lock is delegated, before recordAtom.
        bytes unlockCall;
        // Task #8 recovery path: the SAME leg's cancelCall from the same prepareUnlock receipt
        // that produced unlockCall. BI verifies this one too (verifyCancelCall) before
        // recordAtom -- ALL of its outputs must belong back to this leg's own `from` (the
        // owner), never anyone else, since this is what runs if the trade atom is ever
        // cancelled after this leg has delegated to it.
        bytes cancelCall;
    }

    struct Trade {
        string tradeId;
        bytes32 productType;
        Leg[] legs;
        State state;
        address atomAddress;
        address proposer;
    }

    /// @notice BI's own address (the individual signing identity, not the group address) --
    /// resolved the same way BondTracker's `_custodian`/`_issuer` are: a constructor argument,
    /// a snapshot from deploy time (a private Pente contract cannot read base-ledger state to
    /// discover this some other way).
    address public immutable bi;

    mapping(bytes32 => Trade) private _trades;

    event TradeProposed(string tradeId, bytes32 productType, uint256 legCount);
    event TradeAccepted(string tradeId);
    event LegRecorded(string tradeId, uint256 legIndex, bytes32 lockId);
    event AtomCreated(string tradeId, address atom);
    event TradeSettled(string tradeId);
    event TradeFailed(string tradeId);
    event TradeCancelled(string tradeId);

    error TradeAlreadyExists(string tradeId);
    error TradeNotFound(string tradeId);
    error WrongState(string tradeId, State actual);
    error NotACounterparty(address caller);
    error NotTheLegOwner(address caller, address expected);
    error NotBI(address caller);
    error NotAPartyOrBI(address caller);
    error LegIndexOutOfRange(uint256 legIndex);
    error LegAlreadyPrepared(string tradeId, uint256 legIndex);
    error ProposerNotALegParty(address caller);
    error SelfDealingLeg(uint256 legIndex);
    error TooManyLegs(uint256 legCount);
    error InvalidLegData(string tradeId, uint256 legIndex);

    /// @notice Real products are 2-3 legs (bond/cash, DvP triangles). Caps `legs.length` so
    /// propose() can't let a proposer size a trade such that every later accept()/cancel()/
    /// recordLeg() call (each an O(legs.length) scan) becomes disproportionately expensive for
    /// the other parties (solidity-auditor fix, 2026-10-05, agents 4/6 FINDING
    /// "unbounded-array-gas-dos"/"unbounded-array-gas-griefing").
    uint256 public constant MAX_LEGS = 8;

    constructor(address bi_) {
        // Solidity-auditor fix (2026-10-05, agent 2 FINDING "unchecked-trusted-role-param"):
        // bi is immutable with no setter -- a zero value would permanently brick every
        // onlyBI function (recordAtom/confirmSettled/markFailed) for the lifetime of this
        // contract instance, with no recovery path.
        require(bi_ != address(0), "bi required");
        bi = bi_;
    }

    modifier onlyBI() {
        if (msg.sender != bi) revert NotBI(msg.sender);
        _;
    }

    function _key(string calldata tradeId) internal pure returns (bytes32) {
        return keccak256(bytes(tradeId));
    }

    function _isLegParty(Trade storage trade, address addr) internal view returns (bool) {
        for (uint256 i = 0; i < trade.legs.length; i++) {
            if (trade.legs[i].from == addr || trade.legs[i].to == addr) {
                return true;
            }
        }
        return false;
    }

    function _isLegPartyOfProposal(LegProposal[] calldata legs, address addr) internal pure returns (bool) {
        for (uint256 i = 0; i < legs.length; i++) {
            if (legs[i].from == addr || legs[i].to == addr) {
                return true;
            }
        }
        return false;
    }

    /// @notice Called by the initiating bank (whichever party's user starts the negotiation).
    /// `tradeId` must be fresh (never proposed before on this contract). Audit fix
    /// (solidity-auditor, agent 9 FINDING "missing-caller-authorization"): the caller must be
    /// one of the legs' own `from`/`to` -- unlike every other mutator here, this had no such
    /// check, letting any privacy-group member squat a tradeId with bogus/empty legs and
    /// permanently deny the real trade (CANCELLED, not NONE, is cancel()'s only exit, and an
    /// empty-legs trade can never even reach CANCELLED by anyone but BI, since `_isLegParty`
    /// is vacuously false for every address). This check also closes that empty-legs case,
    /// since no address can be "a party" of zero legs.
    function propose(string calldata tradeId, bytes32 productType, LegProposal[] calldata legs) external {
        if (legs.length > MAX_LEGS) {
            revert TooManyLegs(legs.length);
        }
        if (!_isLegPartyOfProposal(legs, msg.sender)) {
            revert ProposerNotALegParty(msg.sender);
        }
        bytes32 key = _key(tradeId);
        Trade storage trade = _trades[key];
        if (trade.state != State.NONE) {
            revert TradeAlreadyExists(tradeId);
        }

        trade.tradeId = tradeId;
        trade.productType = productType;
        trade.state = State.PROPOSED;
        trade.proposer = msg.sender;
        for (uint256 i = 0; i < legs.length; i++) {
            // Solidity-auditor fix (2026-10-05, agents 2/7/12 FINDING
            // "tradeid-squat(ting)-dos"/"tradeid-squat-via-self-referential-leg"): the
            // caller-must-be-a-leg-party check above is trivially satisfied by a leg where
            // from == to == msg.sender, letting any privacy-group member squat a victim's
            // tradeId with a self-dealing leg (permanent -- no function ever resets a tradeId
            // back to State.NONE). Rejecting from == to closes it at the source.
            if (legs[i].from == legs[i].to) {
                revert SelfDealingLeg(i);
            }
            trade.legs.push(
                Leg({
                    asset: legs[i].asset,
                    from: legs[i].from,
                    to: legs[i].to,
                    amount: legs[i].amount,
                    lockId: bytes32(0),
                    preparedStateId: bytes32(0),
                    unlockCall: "",
                    cancelCall: ""
                })
            );
        }
        emit TradeProposed(tradeId, productType, legs.length);
    }

    /// @notice The named counterparty -- any leg party who is NOT the proposer.
    function accept(string calldata tradeId) external {
        bytes32 key = _key(tradeId);
        Trade storage trade = _trades[key];
        if (trade.state != State.PROPOSED) {
            revert WrongState(tradeId, trade.state);
        }
        if (msg.sender == trade.proposer || !_isLegParty(trade, msg.sender)) {
            revert NotACounterparty(msg.sender);
        }
        trade.state = State.ACCEPTED;
        emit TradeAccepted(tradeId);
    }

    /// @notice Only the bank whose address equals `legs[legIndex].from` may record that leg,
    /// and only once (audit fix below). Once every leg has a non-empty `preparedStateId`,
    /// state advances to LEGS_PREPARED.
    ///
    /// Audit fix (solidity-auditor, 12-agent pass, 2026-10-05 -- 6 of 12 agents independently
    /// converged on this exact bug): the state guard used to accept `LEGS_PREPARED` as well as
    /// `ACCEPTED`. Since state only ever BECOMES LEGS_PREPARED once every leg already has a
    /// non-zero `preparedStateId` (see the loop below), that branch could only ever be reached
    /// to let a leg owner OVERWRITE an already-prepared leg -- never to complete a pending one.
    /// Concretely: with state==LEGS_PREPARED, a leg owner could call this again with
    /// `preparedStateId=bytes32(0)`, which made `allPrepared` recompute false -- but the
    /// one-way `if (allPrepared) { state = LEGS_PREPARED; }` never had an `else`, so `state`
    /// stayed LEGS_PREPARED while a leg was actually unprepared, silently invalidating
    /// whatever BI had already read+verified (verifyDelegatedLeg/verifyCancelCall) for that
    /// leg before building the trade atom. Fixed by narrowing the guard to ACCEPTED only (a
    /// leg can never be recorded a second time, by construction) and, defense-in-depth, an
    /// explicit one-shot check in case any future change reopens the state guard.
    function recordLeg(
        string calldata tradeId,
        uint256 legIndex,
        bytes32 lockId,
        bytes32 preparedStateId,
        bytes calldata unlockCall,
        bytes calldata cancelCall
    ) external {
        bytes32 key = _key(tradeId);
        Trade storage trade = _trades[key];
        if (trade.state != State.ACCEPTED) {
            revert WrongState(tradeId, trade.state);
        }
        if (legIndex >= trade.legs.length) {
            revert LegIndexOutOfRange(legIndex);
        }
        Leg storage leg = trade.legs[legIndex];
        if (msg.sender != leg.from) {
            revert NotTheLegOwner(msg.sender, leg.from);
        }
        // Architecture review fix (2026-10-05): keyed on unlockCall.length, not preparedStateId.
        // unlockCall is caller-supplied calldata -- non-empty on any genuine recordLeg call, by
        // construction. preparedStateId is a content-addressed hash the caller also supplies;
        // nothing on-chain actually PROVES it can never legitimately equal bytes32(0), so keying
        // the one-shot guard on it is a theoretical (if practically vanishing) soundness gap.
        // unlockCall.length gives the same guarantee without resting on that assumption.
        if (leg.unlockCall.length != 0) {
            revert LegAlreadyPrepared(tradeId, legIndex);
        }
        // Solidity-auditor fix (2026-10-05, 9 of 12 agents independently converged on this
        // exact bug, e.g. FINDING "sentinel-desync-dos"/"zero-value-sentinel-deadlock"
        // /"permanent-leg-poison-zero-preparedstateid"): the one-shot re-entry guard above
        // and the allPrepared completion loop below key off two DIFFERENT fields
        // (unlockCall.length vs preparedStateId == 0). A caller could submit
        // preparedStateId=bytes32(0) with a non-empty unlockCall: the guard above trips
        // (blocking any future resubmission of this leg), while the completion loop below
        // never sees this leg as prepared -- permanently stranding the whole trade in
        // ACCEPTED with no recovery but cancel(). The inverse (unlockCall="" with a real
        // preparedStateId) left the guard itself permanently bypassable. Requiring both
        // fields non-degenerate on every call guarantees the two sentinels can never diverge.
        if (preparedStateId == bytes32(0)) {
            revert InvalidLegData(tradeId, legIndex);
        }
        if (unlockCall.length == 0) {
            revert InvalidLegData(tradeId, legIndex);
        }

        leg.lockId = lockId;
        leg.preparedStateId = preparedStateId;
        leg.unlockCall = unlockCall;
        leg.cancelCall = cancelCall;
        emit LegRecorded(tradeId, legIndex, lockId);

        bool allPrepared = true;
        for (uint256 i = 0; i < trade.legs.length; i++) {
            if (trade.legs[i].preparedStateId == bytes32(0)) {
                allPrepared = false;
                break;
            }
        }
        if (allPrepared) {
            trade.state = State.LEGS_PREPARED;
        }
    }

    /// @notice BI only. REORDERED (lead decision, 2026-10-05, closes the cancel() gap below
    /// without a new contract function): this now runs right after BI builds the atom
    /// off-chain, BEFORE any leg delegates to it. BI must have already called paladin-client's
    /// verifyCancelCall for every leg (cancelCall needs no delegation precondition -- see its
    /// own doc comment: it only ever returns a leg's OWN funds to its OWN owner). This
    /// contract cannot enforce that call itself (a Pente private contract cannot read Noto's
    /// state store, a different domain) -- it only records the atom address BI already built.
    /// verifyDelegatedLeg is NOT a precondition here; it runs later, per leg, right after that
    /// leg actually delegates (using this recorded atomAddress as the delegation target) and
    /// before executeAtom, since unlockCall moves funds to the counterparty and still needs
    /// the delegation-gated guarantee (the #5b binding rule, LockImmutable).
    function recordAtom(string calldata tradeId, address atomAddress) external onlyBI {
        bytes32 key = _key(tradeId);
        Trade storage trade = _trades[key];
        if (trade.state != State.LEGS_PREPARED) {
            revert WrongState(tradeId, trade.state);
        }
        trade.atomAddress = atomAddress;
        trade.state = State.ATOM_CREATED;
        emit AtomCreated(tradeId, atomAddress);
    }

    /// @notice BI only -- an attestation, not an on-chain read (a private contract cannot read
    /// the public RestrictedAtom's status). BI calls this after observing
    /// AtomStatusChanged(Executed) via its own blockchain event listener.
    function confirmSettled(string calldata tradeId) external onlyBI {
        bytes32 key = _key(tradeId);
        Trade storage trade = _trades[key];
        if (trade.state != State.ATOM_CREATED) {
            revert WrongState(tradeId, trade.state);
        }
        trade.state = State.SETTLED;
        emit TradeSettled(tradeId);
    }

    /// @notice BI only -- an attestation, called after BI (or any party) has already cancelled
    /// the underlying RestrictedAtom (which releases any delegated legs back to their owners,
    /// see RestrictedAtom.cancel()'s own doc comment) and observed it did not execute.
    function markFailed(string calldata tradeId) external onlyBI {
        bytes32 key = _key(tradeId);
        Trade storage trade = _trades[key];
        if (trade.state != State.ATOM_CREATED) {
            revert WrongState(tradeId, trade.state);
        }
        trade.state = State.FAILED;
        emit TradeFailed(tradeId);
    }

    /// @notice Any party in legs[], or BI. Only while PROPOSED/ACCEPTED/LEGS_PREPARED -- never
    /// after ATOM_CREATED. This call is PURELY AN ATTESTATION for visibility -- it never moves
    /// or releases any funds itself, on any path, because this contract is never the spender
    /// of a Noto lock (Noto's cancelLock/spendLock are onlySpender-gated; only the actual
    /// delegate -- the trade atom -- can ever call them once a lock is delegated).
    ///
    /// This is actually safe now, REORDERED (lead decision, 2026-10-05; not a contract
    /// change): recordAtom runs right after BI builds the atom off-chain, BEFORE any leg
    /// delegates (see its own doc comment). So by construction, no leg can EVER be delegated
    /// while this function is reachable -- every delegation happens strictly inside
    /// ATOM_CREATED, where this function is already unreachable (reverts WrongState). The
    /// audit originally flagged a FALSE premise here ("no leg has been delegated yet" was
    /// claimed while the OLD design still let delegation happen before recordAtom) -- fixed by
    /// changing the required ORDER, not this function, per the lead's explicit decision not to
    /// add a new release path here. If a caller ever violates the required order (delegates
    /// before recordAtom), this function still cannot release that leg -- there would be no
    /// way for this contract to discover an atom address that was never recorded. Don't rely
    /// on this function for fund safety; rely on the order (delegateLock's own doc comment in
    /// paladin-client documents the client-side rule).
    function cancel(string calldata tradeId) external {
        bytes32 key = _key(tradeId);
        Trade storage trade = _trades[key];
        if (trade.state != State.PROPOSED && trade.state != State.ACCEPTED && trade.state != State.LEGS_PREPARED) {
            revert WrongState(tradeId, trade.state);
        }
        if (msg.sender != bi && !_isLegParty(trade, msg.sender)) {
            revert NotAPartyOrBI(msg.sender);
        }
        trade.state = State.CANCELLED;
        emit TradeCancelled(tradeId);
    }

    function getAgreement(string calldata tradeId) external view returns (Trade memory) {
        bytes32 key = _key(tradeId);
        Trade storage trade = _trades[key];
        if (trade.state == State.NONE) {
            revert TradeNotFound(tradeId);
        }
        return trade;
    }
}
