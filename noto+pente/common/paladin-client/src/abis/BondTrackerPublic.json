function\"},{\"inputs\":[],\"name\":\"closeDistribution\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"currencyToken\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"custodian\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"forceCompleteDistribution\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"onDistributionComplete\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"}],\"name\":\"onIssue\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"owner\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"renounceOwnership\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"schema\",\"outputs\":[{\"internalType\":\"string\",\"name\":\"\",\"type\":\"string\"}],\"stateMutability\":\"pure\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"setActive\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"status\",\"outputs\":[{\"internalType\":\"enum BondTrackerPublic.Status\",\"name\":\"\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"trancheCount\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"newOwner\",\"type\":\"address\"}],\"name\":\"transferOwnership\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"errors\":{\"OwnableInvalidOwner(address)\":[{\"details\":\"The owner is not a valid owner account. (eg. `address(0)`)\"}],\"OwnableUnauthorizedAccount(address)\":[{\"details\":\"The caller account is not authorized to perform an operation.\"}]},\"kind\":\"dev\",\"methods\":{\"owner()\":{\"details\":\"Returns the address of the current owner.\"},\"renounceOwnership()\":{\"details\":\"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner.\"},\"transferOwnership(address)\":{\"details\":\"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner.\"}},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"notice\":\"Public half of a bond series: lifecycle STATUS only. Derived from upstream examples/bond BondTrackerPublic (solidity/contracts/shared/BondTrackerPublic.sol at tag v1.0.0). DEVIATION from upstream, on purpose: upstream publishes every sale to this contract (onDistribute(amount) into a TokenDistribution holding totalUnits, price and availableUnits), plus totalSupply and burns. On a public chain that discloses every primary-sale and redemption amount. Platform objective: only BI, the sender and the receiver see amounts. So this contract carries NO amount, price, quantity or supply -- no function argument, no event field, no getter. All of that accounting lives in the private BondTracker (inside the Pente group); it tells this contract only that a status transition happened:   onIssue(custodian)        INITIALIZED/COMPLETE/ACTIVE -> ISSUED   beginDistribution()       -> DISTRIBUTION_STARTED   onDistributionComplete()  STARTED -> COMPLETE   (private counter reached zero: sold out)   forceCompleteDistribution() STARTED -> COMPLETE (custodian writes off the unsold remainder)   closeDistribution()       COMPLETE -> CLOSED   setActive()               CLOSED -> ACTIVE test/BondTrackerPublic.t.sol walks this contract's ABI and fails if an amount-like field ever reappears. Instrument terms (issue/maturity date, face value, currency token) are deliberately public: they are the bond's published terms, not holdings.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/BondTrackerPublic.sol\":\"BondTrackerPublic\"},\"evmVersion\":\"shanghai\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":false,\"runs\":200},\"remappings\":[\":@openzeppelin/contracts-upgradeable/=node_modules/@openzeppelin/contracts-upgradeable/\",\":@openzeppelin/contracts/=node_modules/@openzeppelin/contracts/\",\":paladin-domains/=vendor/paladin-v1.0.0/domains/\",\":paladin-private/=vendor/paladin-v1.0.0/private/\",\":paladin-shared/=vendor/paladin-v1.0.0/shared/\"]},\"sources\":{\"node_modules/@openzeppelin/contracts/access/Ownable.sol\":{\"keccak256\":\"0xff6d0bb2e285473e5311d9d3caacb525ae3538a80758c10649a4d61029b017bb\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://8ed324d3920bb545059d66ab97d43e43ee85fd3bd52e03e401f020afb0b120f6\",\"dweb:/ipfs/QmfEckWLmZkDDcoWrkEvMWhms66xwTLff9DDhegYpvHo1a\"]},\"node_modules/@openzeppelin/contracts/utils/Context.sol\":{\"keccak256\":\"0x493033a8d1b176a037b2cc6a04dad01a5c157722049bbecf632ca876224dd4b2\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://6a708e8a5bdb1011c2c381c9a5cfd8a9a956d7d0a9dc1bd8bcdaf52f76ef2f12\",\"dweb:/ipfs/Qmax9WHBnVsZP46ZxEMNRQpLQnrdE4dK8LehML1Py8FowF\"]},\"src/BondTrackerPublic.sol\":{\"keccak256\":\"0x5891be4618b4c6372cb1a899aa3b08718c4f8a15de1295f3d15b2ffee13bf09f\",\"license\":\"Apache-2.0\",\"urls\":[\"bzz-raw://cd9f16417485702a8e9ab434640dc7991a7106a513005f0f3dd8f84ebebd027f\",\"dweb:/ipfs/QmYQ8po5t6cfKL3iJUXvjWZdakRc8Uy4HLbgXXSKxe7nic\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.28+commit.7893614a"},"language":"Solidity","output":{"abi":[{"inputs":[{"