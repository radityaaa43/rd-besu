{
  "name": "paladin-example-bond",
  "version": "0.0.1",
  "description": "",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node ./src/index.ts --cache ./data",
    "start:prod": "node ./build/index.js --cache ./data",
    "verify": "ts-node ./src/tests/data-persistence.ts --cache ./data",
    "outright": "ts-node ./src/outright.ts --cache ./data",
    "test": "ts-node ./src/tests/consideration.ts && ts-node ./src/tests/wait-balance.ts && ts-node ./src/tests/pending-snapshot.ts && ts-node ./src/tests/restricted-atom.ts && ts-node ./src/tests/reconcile.ts",
    "reconcile": "ts-node ./src/reconcile.ts --cache ./data",
    "test:live-atom":"ts-node ./src/tests/live-restricted-atom.ts --cache ./data","test:live-cancel-issuance":"ts-node ./src/tests/live-cancel-issuance.ts --cache ./data","test:rollback": "ts-node ./src/tests/rollback.ts --cache ./data",
    "copy-abi": "node scripts/contracts.mjs"
  },
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.19.0",
    "copy-file": "^11.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@lfdecentralizedtrust/paladin-sdk": "1.0.0",
    "paladin-example-common": "file:../common"
  }
}
